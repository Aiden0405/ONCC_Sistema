# Seguridad
SECRET_KEY=oncc-clave-super-secreta-cambiar-en-produccion

# Opcion 1: URL completa (prioridad alta)
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/oncc_sistema
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/oncc_sistema

# Opcion 2: Configuracion por piezas
# DB_ENGINE puede ser: sqlite, postgres, postgresql, mysql, mariadb
# Recomendado para este proyecto: postgresql
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oncc_sistema
DB_USER=oncc_user
DB_PASSWORD=oncc_password

# Solo aplica si DB_ENGINE=sqlite
SQLITE_DB_NAME=oncc_sistema.db
